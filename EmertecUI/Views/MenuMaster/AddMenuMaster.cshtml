@model MicroService_Template.Domain.Model.ModelMenuMaster
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string NameMsg = ViewBag.NameMsg;
    string DescriptionMsg = ViewBag.DescriptionMsg;
}

<html>
<body>
    <div class="app-content px-lg-3">
        <div class="app-container container-fluid">
            <div class="card">
                <div class="card-header border-0 cursor-pointer">
                    <div class="card-title m-0">
                        <h3 class="fw-bold m-0">Add Menu</h3>
                    </div>
                </div>
                <form class="form" method="post" action="@Url.Action("AddMenuMaster", "MenuMaster")">
                    <div class="card-body border-top p-9">
                        <div class="row">
                            <div class="col-xl-6">
                                <input type="hidden" id="UserId" value="@Model.MenuId" />
                                <div class="mb-3">
                                    <label for="name" class="form-label col-form-label required fw-semibold fs-6">Name</label>
                                    <input type="text" class="form-control userinput" id="Name" name="name" value="@Model.Name">
                                    @if (!string.IsNullOrEmpty(NameMsg))
                                    {
                                        <span class="text-danger">@NameMsg</span>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label for="Description" class="form-label col-form-label required fw-semibold fs-6">Description</label>
                                    <input type="text" class="form-control userinput" id="Description" name="Description" value="@Model.Description">
                                    @if (!string.IsNullOrEmpty(DescriptionMsg))
                                    {
                                        <span class="text-danger">@DescriptionMsg</span>
                                    }
                                </div>
                                @*  <div class="mb-3">
                                    <label for="Icon" class="form-label col-form-label required fw-semibold fs-6">Icon</label>
                                    <input type="file" class="form-control userinput" id="Icon" name="Icon" value="@Model.Icon">
                                    @* @if (!string.IsNullOrEmpty(passwordMsg))
                                    {
                                        <span class="text-danger">@passwordMsg</span>
                                    } 
                                </div> *@
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-6">
                        @if (ViewBag.msg != null)
                        {
                            <div class="usermsg">
                                @ViewBag.msg
                            </div>
                        }
                    </div>
                    <div class=" py-6 px-9">
                        <button type="submit" class="btn btn-primary me-2" style="width:95px;height:38px;">Save</button>
                        <button class="btn btn-primary me-2" style="width:95px;height:38px;">View</button>
                        <button class="btn btn-primary me-2" style="width:95px;height:38px;">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
