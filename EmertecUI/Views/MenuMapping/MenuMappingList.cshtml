@model IList<MicroService_Template.Domain.Model.ModelUserMenuMapping>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    //IList<MicroService_Template.Domain.Model.ModelUserMenuMapping> MenuMappingList = ViewBag.MenuMappingList;
}

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/css/stylesheet.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/wwwroot/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/wwwroot/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="StyleSheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <title>Users</title>
</head>
<body>
    <button class="btn btn-primary me-2" id="btnAddMenuMapping">Add MenuMapping</button>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>User Name</th>
                <th>Menu Name</th>
            </tr>
        </thead>
        <tbody>
            @{
                var MenuMappingList = Model
                .GroupBy(m => new { m.User.UserId, m.User.Name })
                .Select(g => new
                {
                    UserName = g.Key.Name,
                    MenuList = string.Join(", ", g.Select(x => x.Menu.Name).Distinct())
                })
                .ToList();
                foreach (var menuMapping in MenuMappingList)
                {
                    <tr>
                        <td>@menuMapping.UserName</td>
                        <td>@menuMapping.MenuList</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</body>
</html>
<script type="text/javascript">
    $(document).on("click", "#btnAddMenuMapping", AddMenuMapping);

    function AddMenuMapping(){
       window.location.href = "/MenuMapping/AddMenuMapping";
     };
</script>