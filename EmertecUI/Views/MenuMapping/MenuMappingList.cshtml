@model IList<MicroService_Template.Domain.Model.ModelUserMenuMapping>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var role = ViewBag.UserRole;
}

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/css/stylesheet.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/addpagination.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
    <!-- intl-tel-input CSS -->
    <link href="css/intlTelInput-largeFlags.css" rel="stylesheet" type="text/css" />
    <!-- Select2 CSS -->
    <link href="css/select2.min.css" rel="stylesheet" type="text/css" />
    <!-- Datatables css -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <!-- Select2 Bootstrap4 CSS -->
    <link href="~/css/select2-bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <!-- Remixicon CSS -->
    <link href="~/css/remixicon.css" rel="stylesheet" type="text/css" />
    <!-- SimpleBar CSS -->
    <link href="~/css/simplebar.css" rel="stylesheet" type="text/css" />
    <!-- Bootstrap css -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- App css -->
    <link href="~/css/app-style.css" rel="stylesheet" type="text/css" />
    <title>Menu Mappings</title>
</head>
<body>
    @if (role != "Admin")
    {
        <div class="content-page" style="margin:35px 0 0 0">
            <div class="content">
                <div class="main-inner container-fluid">
                    <div class="row">
                        <!-- Month Filter Dropdown (styled exactly like screenshot) -->
                        <div class="col-12 mb-3">
                            <div class="col-12">
                                <div class="page-title-box add">
                                    <h1 class="page-title">Menu Mapping</h1>

                                    <div class="add-btn">
                                        <a href="#" id="btnAddMenuMapping">
                                            <i class="ri-add-line"></i> <span>Add Menu Mapping</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                           @*  <button class="btn btn-primary me-2" id="btnAddMenuMapping">Add Menu Mapping</button> *@
                            @*  <div class="dropdown">
                        <button id="filterDropdown"
                                class="btn btn-outline-secondary dropdown-toggle month-filter"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            -- All Months -- <i class="ri-arrow-down-s-fill" style="font-size:larger"></i>
                        </button>
                        <ul class="dropdown-menu" id="monthDropdownMenu" aria-labelledby="filterDropdown"></ul>
                    </div> *@
                        </div>
                        <div class="col-12">
                            <div class="card com-profile-info">
                                <!-- Top Header -->
                                <div class="table-top-header">
                                    <h4>List of Menu Mapping</h4>
                                    <div class="d-flex gap-2">
                                        @*  <div class="table-search-box">
                                    <input type="text" id="customFranchiseSearch" class="form-control form-control-sm" placeholder="Search...">
                                    <button type="submit"><i class="ri-search-line"></i></button>
                                </div> *@
                                        @*  <div id="exportFranchiseButtons">
                                    <button id="exportExcel" class="btn-btn-outline-secondary">
                                        <i class="bi bi-file-earmark-excel"></i> Export
                                    </button>
                                </div> *@
                                    </div>
                                </div>
                                <!-- Table -->
                                <div class="table-responsive">
                                    <table id="franchiseTable" class="table dt-responsive nowrap">
                                        <thead>
                                            <tr>
                                                <th class="dt-orderable-asc dt-orderable-desc">UserName</th>
                                                <th>MenuList</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var group in Model.GroupBy(m => new { m.User?.UserId, m.User?.Name }))
                                            {
                                                var firstMapping = group.First();
                                                var userId = group.Key.UserId;
                                                var userName = group.Key.Name;
                                                var menuList = string.Join(", ", group.Select(x => x.Menu?.Name).Distinct());
                                                <tr>
                                                    <td>@userName</td>
                                                    <td>@menuList</td>
                                                    <td>
                                                        <div class="action-items">
                                                        <a href="@Url.Action("AddMenuMapping", "MenuMapping", new { id = firstMapping.UserId })" class="icon-btn">
                                                            <i class="ri-edit-2-line"></i>
                                                        </a>
                                                        <a href="@Url.Action("DeleteMenuMappingUser", "MenuMapping", new { userId = firstMapping.UserId })" class="icon-btn"
                                                           onclick="return confirm('Are you sure you want to delete this mapping?');">
                                                            <i class="ri-delete-bin-3-line"></i>
                                                        </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    <div class="datatable-footer-bottom">
                                        <div class="totle-left">
                                            <span id="totalRecords">Total Reminders: 3</span>
                                        </div>
                                        <div id="pagination" class="dataTables_paginate paging_simple_numbers"></div>
                                        <div class="show-page">
                                            <span>Show per page:</span>
                                            <select id="rowsPerPage" class="form-select">
                                                <option value="5" >5 </option>
                                                <option value="10" selected>10 </option>
                                                <option value="25">25</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="~/js/addpagination.js"></script>
    <!-- Jquery Min JS -->
    <script src="js/jquery.min.js"></script>
    <!-- Bootstrap Bundle JS -->
    <script src="js/bootstrap.bundle.min.js"></script>
    <!-- SimpleBar JS -->
    <script src="js/simplebar.min.js"></script>
    <!-- Select2 JS -->
    <script src="js/select2.min.js"></script>
    <!-- intl-tel-input JS -->
    <script src="js/intlTelInput.min.js"></script>
    <!-- Dropzone JS -->
    <script src="js/dropzone.min.js"></script>
    <!-- Repeater JS -->
    <script src="js/jquery.repeater.min.js"></script>
    <!-- Datatables js -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <!-- Datatable Init js -->
    <script src="~/js/datatable-init.js"></script>
    <!-- Script App JS -->
    <script src="~/js/script-app.js"></script>

</body>
</html>


<script type="text/javascript">
    $(document).on("click", "#btnAddMenuMapping", function () {
        window.location.href = "/MenuMapping/AddMenuMapping";
    });
</script>
