@model MicroService_Template.Domain.Model.ModelUserMenuMapping
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    IList<MicroService_Template.Domain.Model.ModelUsers> UserList = ViewBag.UserList;
    IList<MicroService_Template.Domain.Model.ModelMenuMaster> MenuMasterList = ViewBag.MenuMasterList;
    string NameMsg = ViewBag.NameMsg;
    string DescriptionMsg = ViewBag.DescriptionMsg;
    string check = string.Empty;
}

<html>
<body>
    <div class="app-content px-lg-3">
        <div class="app-container container-fluid">
            <div class="card">
                <div class="card-header border-0 cursor-pointer">
                    <div class="card-title m-0">
                        <h3 class="fw-bold m-0">Menu Mapping</h3>
                    </div>
                </div>
                <form class="form" method="post" action="@Url.Action("AddMenuMapping", "MenuMapping")">
                    <div class="card-body border-top p-9">
                        <div class="row">
                            <div class="col-xl-6">
                                <input type="hidden" id="UserMenuMappingId" name="UserMenuMappingId" value="@Model.UserMenuMappingId" />
                                <div class="mb-3">
                                    <label for="UserId" class="form-label col-form-label required fw-semibold fs-6">Select User</label>
                                    <select class="form-select" id="UserId" name="UserId">
                                        <option value="0" selected="@(Model.UserId == 0 ? "selected" : null)">-select-</option>
                                        @foreach (var item in UserList)
                                        {
                                            <option value="@item.UserId" selected="@(Model.UserId == item.UserId? "selected" : null)">
                                                @item.Name
                                            </option>
                                        }
                                    </select>
                                    @* @if (!string.IsNullOrEmpty(UserRoleMsg))
                                    {
                                        <span class="text-danger">@UserRoleMsg</span>
                                    } *@
                                    <label class="form-label required fw-semibold fs-6">Select Menus</label>
                                    @foreach (var menu in MenuMasterList)
                                    {
                                        var isChecked = !string.IsNullOrEmpty(Model.MenuIds) && Model.MenuIds.Split(',').Contains(menu.MenuId.ToString()) ? "checked" : "";
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="SelectedMenuIds" value="@menu.MenuId" @isChecked id="menu_@menu.MenuId" />
                                            <label class="form-check-label" for="menu_@menu.MenuId">@menu.Name</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-6">
                        @if (ViewBag.msg != null)
                        {
                            <div class="usermsg">
                                @ViewBag.msg
                            </div>
                        }
                    </div>
                    <div class=" py-6 px-9">
                        <button type="submit" class="btn btn-primary me-2" style="width:95px;height:38px;">Save</button>
                        <button class="btn btn-primary me-2" style="width:95px;height:38px;">View</button>
                        <button class="btn btn-primary me-2" style="width:95px;height:38px;">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
