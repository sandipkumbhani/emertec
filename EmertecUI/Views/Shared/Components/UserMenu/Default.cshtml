@using MicroService_Template.Domain.Model
@model List<ModelMenuMaster>

@foreach (var menu in Model)
{
    if (!string.IsNullOrEmpty(menu.Url))
    {
        <li class="nav-item">
            <a class="nav-link" href="@menu.Url"
            @(menu.Url.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? "target=\"_blank\"" : "")>
                <i class="@menu.Icon" style="display:flow"></i>
                <span>@menu.Name</span>
            </a>
        </li>
    }
}
