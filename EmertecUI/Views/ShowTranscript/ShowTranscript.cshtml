@model MicroService_Template.Domain.Model.ModelDimJson
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    IList<MicroService_Template.Domain.Model.ModelDimJson> Filelist = ViewBag.FileList;
    IList<MicroService_Template.Domain.Model.ModelDimJson> IsTranscript = ViewBag.IsTranscript;
}
<head>
    <link href="~/css/addpagination.css" rel="stylesheet" />
</head>
<link href="~/css/showtranscript.css" rel="stylesheet" />
<div class="content-page">
    <div class="content">
        <div class="main-inner container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card com-profile-info">
                        <div class="table-top-header">
                            <h3>Show Transcripts</h3>
                        </div>
                        <div class="table-responsive">
                            <ul class="nav nav-tabs" id="fileTab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="files-tab" data-bs-toggle="tab" data-bs-target="#files" type="button" role="tab" aria-controls="files" aria-selected="true">
                                        Active
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="other-tab" data-bs-toggle="tab" data-bs-target="#other" type="button" role="tab" aria-controls="other" aria-selected="false">
                                        Trascripted
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content mt-3" id="fileTabContent">
                                <div class="tab-pane fade show active" id="files" role="tabpanel" aria-labelledby="files-tab">
                                    <table class="table table-bordered" id="franchiseTable">
                                        <thead>
                                            <tr>
                                                <th>File Name</th>
                                                <th>User Name</th>
                                                <th>Inserted Date Time</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Filelist != null && Filelist.Any())
                                            {
                                                foreach (var file in Filelist)
                                                {
                                                    <tr>
                                                        <td>@file.FileName</td>
                                                        <td>@file.InsertName</td>
                                                        <td>@file.InsertDate.ToString("yyyy-MM-dd HH:mm")</td>
                                                        <td>
                                                            <button type="button" class="btn btn-primary"
                                                                    onclick="loadTranscript('@file.FileName')"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#transcriptModal">
                                                                View
                                                            </button>
                                                        </td>
                                                        <td>
                                                            <a href="@Url.Action("ShowTranscriptInNewPage", "ShowTranscript", new { fileName = file.FileName })"
                                                               class="btn btn-primary"
                                                               target="_blank">
                                                                Open In New Window
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="2">No files available.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>


                                <div class="tab-pane fade" id="other" role="tabpanel" aria-labelledby="other-tab">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>File Name</th>
                                                <th>User Name</th>
                                                <th>Transcripted Date Time</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (IsTranscript != null && IsTranscript.Any())
                                            {
                                                foreach (var file in IsTranscript)
                                                {
                                                    <tr>
                                                        <td>@file.FileName</td>
                                                        <td>@file.UpdeterName</td>
                                                        <td>@file.UpdateDate.ToString("yyyy-MM-dd HH:mm")</td>
                                                    </tr>

                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td>No transcripted files available.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="modal fade" id="transcriptModal" tabindex="-1" aria-labelledby="transcriptModalLabel" aria-hidden="true">
                                <div style="padding: 50px; font-size:18px">
                                    <div class="modal-dialog modal-xl modal-dialog-scrollable">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Transcript</h5>
                                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                                    <button type="button" class="btn btn-primary" onclick="copyAllSentences()" title="Copy All Sentences">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-copy" viewBox="0 0 16 16">
                                                            <path fill-rule="evenodd" d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z" />
                                                        </svg>
                                                        <span>Copy</span>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="modal-body">

                                                <ul class="nav nav-tabs" id="singleTab" role="tablist">
                                                    <li class="nav-item" role="presentation">
                                                        <button class="nav-link active" id="transcript-tab"
                                                                data-bs-toggle="tab"
                                                                data-bs-target="#transcript-tab-pane"
                                                                type="button" role="tab"
                                                                aria-controls="transcript-tab-pane"
                                                                aria-selected="true"
                                                                onclick="loadTranscriptTab()">
                                                            Text View
                                                        </button>
                                                    </li>
                                                    <li class="nav-item" role="presentation">
                                                        <button class="nav-link" id="chat-tab"
                                                                data-bs-toggle="tab"
                                                                data-bs-target="#chat-tab-pane"
                                                                type="button" role="tab"
                                                                aria-controls="chat-tab-pane"
                                                                aria-selected="false">
                                                            Chat View
                                                        </button>
                                                    </li>
                                                </ul>
                                                <div class="tab-content mt-3" id="singleTabContent">
                                                    <div class="tab-pane fade show active" id="transcript-tab-pane" role="tabpanel" aria-labelledby="transcript-tab">
                                                        <div id="transcriptContent" class="tab-content-box">
                                                            <div class="text-muted">Click "Text" to load content...</div>
                                                        </div>
                                                    </div>
                                                    <div class="tab-pane fade" id="chat-tab-pane" role="tabpanel" aria-labelledby="chat-tab">
                                                        <div id="transcriptContentChat" class="tab-content-box">
                                                            <div class="text-muted">Click "Chat View" to load content...</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form method="post" asp-controller="ShowTranscript" asp-action="MarkAsTranscripted" style="display:inline;">
                                                    <input type="hidden" id="filenameInput" name="filename" />
                                                    <button type="submit" class="btn btn-primary">Transcripted</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                            </div>
                            <div class="datatable-footer-bottom">
                                <div class="totle-left">
                                    <span id="totalRecords">Total Reminders: 3</span>
                                </div>
                                <div id="pagination" class="dataTables_paginate paging_simple_numbers"></div>
                                <div class="show-page">
                                    <span>Show per page:</span>
                                    <select id="rowsPerPage" class="form-select">
                                        <option value="5">5 </option>
                                        <option value="10" selected>10 </option>
                                        <option value="25">25</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script type="text/javascript">
                    function loadTranscript(fileName) {
                        const url = `/ShowTranscript/View?fileName=${encodeURIComponent(fileName)}`;
                        document.getElementById("filenameInput").value = fileName;
                        fetch(url)
                            .then(response => response.text())
                            .then(html => {
                                document.getElementById("transcriptContent").innerHTML = html;
                                document.getElementById("transcriptContentChat").innerHTML = html;
                            })
                            .catch(err => {
                                document.getElementById("transcriptContent").innerHTML =
                                    '<div class="alert alert-danger">Failed to load transcript.</div>';
                            });
            }
             function copyAllSentences() {
                    const sentences = [];
                    document.querySelectorAll(".chat-message").forEach(function (el) {
                        sentences.push(el.textContent.trim());
                    });

                    if (sentences.length === 0) {
                        alert("No sentences to copy.");
                        return;
                    }

                    navigator.clipboard.writeText(sentences.join("\n"))
                        .then(() => {
                            alert("Copied all sentences to clipboard!");
                        })
                        .catch(err => {
                            console.error("Copy failed: ", err);
                            alert("Failed to copy.");
                        });
                }
        </script>
        <script src="~/js/addpagination.js"></script>


    </div>
</div>