@model MicroService_Template.Domain.Model.ModelDimJson
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<html>
<body>
    <div class="content-page">
        <div class="content">
            <div class="main-inner container-fluid">
                <div class="row">
                    <div class="col-12">
                        <div class="page-title-box">
                            <h1 class="page-title">Show Transcript</h1>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="card com-profile-info">
                            <div class="top-details">
                                <h2 class="page-form-title">Search Transcript by Telephone</h2>
                                <form class="row all-custom-class" method="get" action="@Url.Action("ShowTranscript", "ShowTranscript")">
                                    <div class="col-xl-4 col-lg-6">
                                        <input type="hidden" id="Id" value="@Model.Id" />
                                        <div class="item-input">
                                            <label for="telephoneNo" class="form-label col-form-label required fw-semibold fs-6">Telephone Number</label>
                                            <input type="text" class="form-control userinput" id="telephoneNo" name="telephoneNo" value="@Model.TelephoneNumber">&nbsp;

                                        </div>
                                    </div>
                                    <div class="col-xl-4 col-lg-6" style="align-content:center;">
                                        <div class="item-input">
                                            <button type="submit" class="btn btn-primary" style="margin-top:4%;">Search</button>
                                        </div>
                                    </div>
                                </form>

                                @if (!string.IsNullOrEmpty(ViewBag.Error))
                                {
                                    <div class="alert alert-danger mt-3">@ViewBag.Error</div>
                                }

                                @if (Model?.Sentences != null && Model.Sentences.Any())
                                {
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <label class="form-label fw-semibold">Sentence</label>
                                        <button type="button" class="btn btn-primary" onclick="copyAllSentences()" title="Copy All Sentences">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-copy" viewBox="0 0 16 16">
                                                <path fill-rule="evenodd" d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z" />
                                            </svg>
                                            <span>Copy</span>
                                        </button>
                                    </div>

                                    <style>
                                        .chat-container {
                                            display: flex;
                                            flex-direction: column;
                                            gap: 10px;
                                        }

                                        .chat-message {
                                            max-width: 70%;
                                            padding: 10px 15px;
                                            border-radius: 15px;
                                            font-size: 14px;
                                            word-break: break-word;
                                            display: inline-block;
                                        }

                                        .agent-message {
                                            background-color:antiquewhite;
                                            align-self: flex-start;
                                            text-align: left;
                                        }

                                        .receiver-message {
                                            background-color: #d8eafd;
                                            align-self: flex-end;
                                            text-align: right;
                                        }
                                    </style>


                                    <div class="chat-container">
                                        @foreach (var sentence in Model.Sentences)
                                        {
                                            var isAgent = sentence.Text?.StartsWith("Speaker 0:") ?? false;
                                            var messageText = sentence.Text?
                                            .Replace("Speaker 0:", "Agent:")
                                            .Replace("Speaker 1:", "Receiver:")
                                            .Trim();

                                            <div class="chat-message @(isAgent ? "agent-message" : "receiver-message")">
                                                @messageText
                                            </div>
                                        }
                                    </div>



                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        function copyAllSentences() {
            const sentences = [];
            document.querySelectorAll(".chat-message").forEach(function (el) {
                sentences.push(el.textContent.trim());
            });

            if (sentences.length === 0) {
                alert("No sentences to copy.");
                return;
            }

            navigator.clipboard.writeText(sentences.join("\n"))
                .then(() => {
                    alert("Copied all sentences to clipboard!");
                })
                .catch(err => {
                    console.error("Copy failed: ", err);
                    alert("Failed to copy.");
                });
        }
    </script>

</body>
</html>