@model MicroService_Template.Domain.Model.ModelDimJson
@{
    Layout = null;
    var fileName = ViewBag.FileName;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="~/css/showtranscript.css" rel="stylesheet" />

<div class="modal-body">
    <div style="padding: 50px; font-size:18px">
    <ul class="nav nav-tabs" id="singleTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="transcript-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#transcript-tab-pane"
                    type="button" role="tab"
                    aria-controls="transcript-tab-pane"
                    aria-selected="true">
                Text View
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="chat-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#chat-tab-pane"
                    type="button" role="tab"
                    aria-controls="chat-tab-pane"
                    aria-selected="false">
                Chat View
            </button>
        </li>
    </ul>
    <div class="tab-content mt-3" id="singleTabContent"> 
        <div class="tab-pane fade show active" id="transcript-tab-pane" role="tabpanel" aria-labelledby="transcript-tab">
            @if (Model?.Sentences != null && Model.Sentences.Any())
            {
                <div class="chat-container">
                    @foreach (var sentence in Model.Sentences)
                    {
                        var isAgent = sentence.Text?.StartsWith("Speaker 0:") ?? false;
                        var messageText = sentence.Text?
                        .Replace("Speaker 0:", "Agent:")
                        .Replace("Speaker 1:", "Receiver:")
                        .Trim();

                        <div class="chat-message @(isAgent ? "agent-message" : "receiver-message")">
                            @messageText
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            else
            {
                <div class="text-muted">No transcript found.</div>
            }

        </div>
        <div class="tab-pane fade" id="chat-tab-pane" role="tabpanel" aria-labelledby="chat-tab">
            @if (Model?.Sentences != null && Model.Sentences.Any())
            {
                <div class="chat-container">
                    @foreach (var sentence in Model.Sentences)
                    {
                        var isAgent = sentence.Text?.StartsWith("Speaker 0:") ?? false;
                        var messageText = sentence.Text?
                        .Replace("Speaker 0:", "Agent:")
                        .Replace("Speaker 1:", "Receiver:")
                        .Trim();

                        <div class="chat-message @(isAgent ? "agent-message" : "receiver-message")">
                            @messageText
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            else
            {
                <div class="text-muted">No transcript found.</div>
            }
        </div>
    </div>
        <div class="modal-footer d-flex justify-content-start mt-3">
        <form method="post" asp-action="MarkAsTranscripted" asp-controller="ShowTranscript">
            <input type="hidden" name="filename" value="@ViewBag.FileName" />
            <button type="submit" class="btn btn-primary">Transcripted</button>
            <a href="/ShowTranscript/ShowTranscript" class="btn btn-secondary">Cancel</a>
        </form>
        </div>
        </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
