@model MicroService_Template.Domain.Model.ModelUsers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    IList<MicroService_Template.Domain.Model.ModelUsers> UserList = ViewBag.UserList;
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/css/stylesheet.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/wwwroot/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/wwwroot/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/record.css" rel="stylesheet" />
    <link rel="StyleSheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <title>Users</title>
</head>
<body>
    <div class="content-page" style="margin:35px 0 0 0">
        <div class="content">
            <div class="main-inner container-fluid">
                <div class="row">
                    <!-- Month Filter Dropdown (styled exactly like screenshot) -->
                    <div class="col-12 mb-3">
                        <button class="btn btn-primary me-2" style="width:95px;height:38px;" id="btnAddUser">Add User</button>
                        @*  <div class="dropdown">
                        <button id="filterDropdown"
                                class="btn btn-outline-secondary dropdown-toggle month-filter"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            -- All Months -- <i class="ri-arrow-down-s-fill" style="font-size:larger"></i>
                        </button>
                        <ul class="dropdown-menu" id="monthDropdownMenu" aria-labelledby="filterDropdown"></ul>
                    </div> *@
                    </div>
                    <div class="col-12">
                        <div class="card com-profile-info">
                            <!-- Top Header -->
                            <div class="table-top-header">
                                <h3>Users</h3>
                                <div class="d-flex gap-2">
                                    @*  <div class="table-search-box">
                                    <input type="text" id="customFranchiseSearch" class="form-control form-control-sm" placeholder="Search...">
                                    <button type="submit"><i class="ri-search-line"></i></button>
                                </div> *@
                                    @*  <div id="exportFranchiseButtons">
                                    <button id="exportExcel" class="btn-btn-outline-secondary">
                                        <i class="bi bi-file-earmark-excel"></i> Export
                                    </button>
                                </div> *@
                                </div>
                            </div>
                            <!-- Table -->
                            <div class="table-responsive">
                                <table id="franchiseTable" class="table dt-responsive nowrap">
                                    <thead>
                                        <tr>
                                            <th class="dt-orderable-asc dt-orderable-desc">Name</th>
                                            <th>Email</th>
                                            <th>User Role</th>
                                            <th>Active</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in UserList)
                                        {
                                            <tr>
                                                <td>@user.Name</td>
                                                <td>@user.EmailId</td>
                                                <td>@user.UserRole?.Name</td>
                                                <td>@user.IsActive</td>
                                                <td>
                                                    <a href="@Url.Action("AddUser", "User", new { id = user.UserId })" class="btn btn-sm btn-warning me-1">
                                                        <i class="bi bi-pencil"></i> Edit
                                                    </a>
                                                    <a href="@Url.Action("DeleteUser", "User", new { id = user.UserId })" class="btn btn-sm btn-danger"
                                                       onclick="return confirm('Are you sure you want to delete this user?');">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <!-- Bottom Area -->
                                <div class="datatable-footer-bottom">
                                    <div class="totle-left">
                                        <span id="totalList">Total List: <span id="recordCount">0</span></span>
                                    </div>
                                    <div id="customFranchisePagination" class="dataTables_paginate paging_simple_numbers"></div>
                                    <div class="show-page">
                                        <span>Show per page:</span>
                                        <select id="pageLength" class="form-select"></select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script type="text/javascript">
    $(document).on("click", "#btnAddUser", AddUser);

    function AddUser(){
       window.location.href = "/User/AddUser";
     };
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="~/js/record.js" defer></script>
