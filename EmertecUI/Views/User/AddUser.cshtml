@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    IList<MicroService_Template.Domain.Model.ModelUserRole> RoleList = ViewBag.RoleList;
}

<html>
<body>
    <div class="app-content px-lg-3">
        <div class="app-container container-fluid">
            <div class="card">
                <div class="card-header border-0 cursor-pointer">
                    <div class="card-title m-0">
                        <h3 class="fw-bold m-0">Add User</h3>
                    </div>
                </div>
                <form class="form" method="post" action="@Url.Action("AddUserAsync", "User")">
                    <div class="card-body border-top p-9">
                        <div class="row">
                            <div class="col-xl-6">
                                <div class="mb-3">
                                    <label for="name" class="form-label col-form-label required fw-semibold fs-6">Name</label>
                                    <input type="text" class="form-control userinput" id="name" name="name" required>
                                </div>
                                <div class="mb-3">
                                    <label for="email" class="form-label col-form-label required fw-semibold fs-6">Email</label>
                                    <input type="email" class="form-control userinput" id="email" name="email" required>
                                </div>
                                <div class="mb-3">
                                    <label for="Password" class="form-label col-form-label required fw-semibold fs-6">Password</label>
                                    <input type="tel" class="form-control userinput" id="mobileNo" name="mobileNo" required>
                                </div>
                                <div class="mb-3">
                                    <label for="ConfirmPassword" class="form-label col-form-label required fw-semibold fs-6">Confirm Password</label>
                                    <input type="password" class="form-control userinput" id="password" name="password" required>
                                </div> 
                                <div>
                                    <label for="RoleId" class="form-label col-form-label required fw-semibold fs-6">Role</label>
                                    <select class="form-select" aria-label="Default select example" id="RoleId" name="RoleId">
                                        <option id="0" selected>-select-</option>
                                        @foreach (var item in RoleList)
                                        {
                                            <option id="@item.UserRoleId">@item.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-6">
                        @if (ViewBag.msg != null)
                        {
                            <div class="usermsg">
                                @ViewBag.msg
                            </div>
                        }
                    </div>
                    <div class="card-footer d-flex justify-content-srtat py-6 px-9">
                        <button type="submit" class="btn btn-primary me-2" style="width:95px;height:38px;">Save</button>
                        <button class="btn btn-primary me-2" style="width:95px;height:38px;">View</button>
                        <button class="btn btn-primary me-2" style="width:95px;height:38px;">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
