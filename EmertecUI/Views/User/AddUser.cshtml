@model MicroService_Template.Domain.Model.ModelUsers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    IList<MicroService_Template.Domain.Model.ModelUserRole> RoleList = ViewBag.RoleList;
    string NameMsg = ViewBag.NameMsg;
    string EmailMsg = ViewBag.EmailMsg;
    string passwordMsg = ViewBag.passwordMsg;
    string ConfirmPasswordMsg = ViewBag.ConfirmPasswordMsg;
    string UserRoleMsg = ViewBag.UserRoleMsg;
    
}

<html>
<body>
    <div class="app-content px-lg-3">
        <div class="app-container container-fluid">
            <div class="card">
                <div class="card-header border-0 cursor-pointer">
                    <div class="card-title m-0">
                        <h3 class="fw-bold m-0">Add User</h3>
                    </div>
                </div>
                <form class="form" method="post" action="@Url.Action("AddUser", "User")">
                    <div class="card-body border-top p-9">
                        <div class="row">
                            <div class="col-xl-6">
                                <input type="hidden" id="UserId" value="@Model.UserId" />
                                <div class="mb-3">
                                    <label for="name" class="form-label col-form-label required fw-semibold fs-6">Name</label>
                                    <input type="text" class="form-control userinput" id="Name" name="name" value="@Model.Name">
                                    @if (!string.IsNullOrEmpty(NameMsg))
                                    {
                                        <span class="text-danger">@NameMsg</span>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label for="EmailId" class="form-label col-form-label required fw-semibold fs-6">Email</label>
                                    <input type="email" class="form-control userinput" id="EmailId" name="EmailId" value="@Model.EmailId">
                                    @if (!string.IsNullOrEmpty(EmailMsg))
                                    {
                                        <span class="text-danger">@EmailMsg</span>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label for="Password" class="form-label col-form-label required fw-semibold fs-6">Password</label>
                                    <input type="password" class="form-control userinput" id="Password" name="Password" value="@Model.Password">
                                    @if (!string.IsNullOrEmpty(passwordMsg))
                                    {
                                        <span class="text-danger">@passwordMsg</span>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label for="ConfirmPassword" class="form-label col-form-label required fw-semibold fs-6">Confirm Password</label>
                                    <input type="password" class="form-control userinput" id="ConfirmPassword" name="ConfirmPassword" value="@Model.ConfirmPassword">
                                    @if (!string.IsNullOrEmpty(ConfirmPasswordMsg))
                                    {
                                        <span class="text-danger">@ConfirmPasswordMsg</span>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label for="UserRoleId" class="form-label col-form-label required fw-semibold fs-6">Role</label>
                                    <select class="form-select" aria-label="Default select example" id="UserRoleId" name="UserRoleId">
                                        <option value="0" selected="@(Model.UserRoleId == 0 ? "selected" : null)">-select-</option>
                                        @foreach (var item in RoleList)
                                        {
                                            <option value="@item.UserRoleId" selected="@(Model.UserRoleId == item.UserRoleId ? "selected" : null)">
                                                @item.Name
                                            </option>
                                        }
                                    </select>
                                    @if (!string.IsNullOrEmpty(UserRoleMsg))
                                    {
                                        <span class="text-danger">@UserRoleMsg</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-6">
                        @if (ViewBag.msg != null)
                        {
                            <div class="usermsg">
                                @ViewBag.msg
                            </div>
                        }
                    </div>
                    <div class=" py-6 px-9">
                        <button type="submit" class="btn btn-primary me-2" style="width:95px;height:38px;">Save</button>
                        <button class="btn btn-primary me-2" style="width:95px;height:38px;">View</button>
                        <button class="btn btn-primary me-2" style="width:95px;height:38px;">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
